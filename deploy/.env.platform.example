# Shared platform services (deploy/docker-compose.base.yml).
# Copy to deploy/.env.platform and fill with long random values, e.g.
#   openssl rand -hex 32
# Never commit deploy/.env.platform.
PLATFORM_POSTGRES_USER=bakimevi_platform
PLATFORM_POSTGRES_PASSWORD=
PLATFORM_REDIS_PASSWORD=
PLATFORM_MINIO_ROOT_USER=bakimevi_minio
PLATFORM_MINIO_ROOT_PASSWORD=
